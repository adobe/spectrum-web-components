{
  "problemMatcher": [
    {
      "owner": "tsc",
      "pattern": [
        {
          "regexp": "^(.+?)\\((\\d+),(\\d+)\\): (error|warning) (TS\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "tsc-build",
      "pattern": [
        {
          "regexp": "^(error|warning) (TS\\d+): (.+)$",
          "severity": 1,
          "code": 2,
          "message": 3
        }
      ]
    }
  ]
}
