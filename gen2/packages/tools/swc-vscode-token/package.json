{
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:postcss",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "author": "Adobe",
  "bugs": {
    "url": "https://github.com/adobe/spectrum-web-components/issues"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "css",
        "path": "./snippets/typography.code-snippets"
      },
      {
        "language": "scss",
        "path": "./snippets/typography.code-snippets"
      },
      {
        "language": "postcss",
        "path": "./snippets/typography.code-snippets"
      }
    ]
  },
  "contributors": [
    "Stephanie Eckles <5t3ph@users.noreply.github.com>"
  ],
  "dependencies": {
    "vscode-languageclient": "10.1.2",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "description": "Autocomplete, hover, and diagnostics for token() values",
  "devDependencies": {
    "@adobe/swc-tokens": "workspace:*",
    "@types/node": "26.6.4",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vsce": "2.15.0"
  },
  "displayName": "SWC token() Intellisense",
  "engines": {
    "vscode": "^1.100.0"
  },
  "homepage": "https://spectrum-web-components.adobe.com/",
  "icon": "resources/icon.png",
  "keywords": [
    "design-system",
    "spectrum",
    "adobe",
    "adobe-spectrum",
    "gen2"
  ],
  "license": "Apache-2.0",
  "main": "./out/client/extension.js",
  "name": "swc-vscode-token",
  "private": true,
  "publisher": "adobe",
  "repository": {
    "directory": "gen2/packages/tools/swc-vscode-token",
    "type": "git",
    "url": "https://github.com/adobe/spectrum-web-components.git"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:snippets": "node ./scripts/generate-typography-snippets.mjs",
    "deploy": "yarn build && yarn package",
    "package": "yarn build:snippets && vsce package --no-dependencies",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "tokens": "swc-tokens --outputType data --out ./tokens.json --prefix swc && yarn build:snippets"
  },
  "version": "0.1.1"
}
