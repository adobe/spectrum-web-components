    },
    "./controllers.js": {
      "types": "./dist/controllers.d.ts",
      "import": "./dist/controllers.js"
    },
    "./controllers/color-controller.js": {
      "types": "./dist/controllers/color-controller.d.ts",
      "import": "./dist/controllers/color-controller.js"
    },
    "./controllers/drag-and-drop-controller.js": {
      "types": "./dist/controllers/drag-and-drop-controller.d.ts",
      "import": "./dist/controllers/drag-and-drop-controller.js"
    },
    "./controllers/field-association-controller.js": {
      "types": "./dist/controllers/field-association-controller.d.ts",
      "import": "./dist/controllers/field-association-controller.js"
    },
    "./controllers/focusgroup-navigation-controller.js": {
      "types": "./dist/controllers/focusgroup-navigation-controller.d.ts",
      "import": "./dist/controllers/focusgroup-navigation-controller.js"
    },
    "./controllers/hover-controller.js": {
      "types": "./dist/controllers/hover-controller.d.ts",
