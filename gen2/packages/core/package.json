    "./controllers/placement-controller.js": {
      "types": "./dist/controllers/placement-controller.d.ts",
      "import": "./dist/controllers/placement-controller.js"
    },
    "./controllers/slot-attribute-propagation-controller.js": {
      "types": "./dist/controllers/slot-attribute-propagation-controller.d.ts",
