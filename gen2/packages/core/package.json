  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.6",
    "@lit-labs/observers": "2.0.2",
    "colorjs.io": "0.5.2",
    "lit": "^2.5.0 || ^3.1.3"
  },
  "devDependencies": {
    "glob": "11.0.3",
    "rimraf": "6.0.1",
