      "types": "./dist/controllers/trigger-press-controller.d.ts",
      "import": "./dist/controllers/trigger-press-controller.js"
    },
    "./directives.js": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/directives.js"
    },
    "./directives/pending-spinner.js": {
      "types": "./dist/directives/pending-spinner.d.ts",
      "import": "./dist/directives/pending-spinner.js"
