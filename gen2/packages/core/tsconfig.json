{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": true,
    "noEmit": false,
    "outDir": "./dist",
    "paths": {
      "@adobe/spectrum-wc-core/*": ["./*"],
      "@swc-test-helpers/dom": ["../../test/helpers/dom/index.ts"],
      "@swc-test-helpers/playwright": ["../../test/helpers/playwright/index.ts"]
    },
    "rootDir": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/stories/**"
  ],
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts"]
}
