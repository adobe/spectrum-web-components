{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "paths": {
      "@adobe/spectrum-wc-core/*": ["../core/*"],
      "@test-helpers/dom": ["../../test/helpers/dom/index.ts"],
      "@test-helpers/playwright": ["../../test/helpers/playwright/index.ts"]
    },
    "rootDir": "./",
    "types": ["@vitest/browser-playwright"]
  },
  "exclude": ["node_modules", "dist", "**/*.vrt.ts", "**/*.a11y.spec.ts"],
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "**/*.d.ts", "src/vite-env.d.ts"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
