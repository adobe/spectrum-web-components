{
  "name": "@adobe/spectrum-wc-icons",
  "version": "2.0.0-beta.4",
  "description": "Spectrum 2 workflow icons as tree-shakeable custom elements and SVG-string functions",
  "license": "Apache-2.0",
  "author": "Adobe",
  "homepage": "https://spectrum-web-components.adobe.com/",
  "repository": {
    "directory": "gen2/packages/icons",
    "type": "git",
    "url": "https://github.com/adobe/spectrum-web-components.git"
  },
  "bugs": {
    "url": "https://github.com/adobe/spectrum-web-components/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./customElements": "./dist/custom-elements.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "analyze": "cem analyze --config cem.config.js",
    "build": "yarn check:icon-styles && tsc --build && vite build && yarn analyze && yarn verify:tree-shaking",
    "check:icon-styles": "node scripts/copy-icon-base-styles.mjs --check",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "generate:icon-styles": "node scripts/copy-icon-base-styles.mjs",
    "generate:workflow-icons": "node scripts/generate-workflow-icons.mjs && prettier --write \"src/*.ts\" && yarn generate:icon-styles",
    "prepublishOnly": "yarn build",
    "test": "node scripts/verify-tree-shaking.mjs",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs"
  },
  "sideEffects": [
    "**/swc-icon-*.js",
    "**/swc-icon-*.ts",
    "**/elements.js",
    "**/elements.ts"
  ],
  "dependencies": {
    "@adobe/spectrum-wc-core": "2.0.0-beta.4",
    "lit": "^2.5.0 || ^3.1.3"
  },
  "devDependencies": {
    "@adobe/postcss-token": "workspace:*",
    "@adobe/swc-tokens": "workspace:*",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@storybook/test": "8.6.15",
    "@storybook/web-components": "10.6.1",
    "@vitest/browser-playwright": "5.0.3",
    "autoprefixer": "10.6.1",
    "chromatic": "18.11.0",
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "postcss": "8.5.29",
    "postcss-preset-env": "11.6.1",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-lit-css": "3.1.0"
  },
  "keywords": [
    "design-system",
    "spectrum",
    "adobe",
    "adobe-spectrum",
    "web components",
    "web-components",
    "lit-element",
    "lit-html",
    "component",
    "css"
  ],
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
