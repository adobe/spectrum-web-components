{
  "name": "@adobe/spectrum-wc",
  "version": "2.0.0-beta.4",
  "description": "Spectrum Web Components gen2 - rendering implementations",
  "license": "Apache-2.0",
  "author": "Adobe",
  "homepage": "https://spectrum-web-components.adobe.com/",
  "repository": {
    "directory": "gen2/packages/swc",
    "type": "git",
    "url": "https://github.com/adobe/spectrum-web-components.git"
  },
  "bugs": {
    "url": "https://github.com/adobe/spectrum-web-components/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./*.css": {
      "types": "./dist/*.css.d.ts",
      "default": "./dist/*.css"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./customElements": "./dist/custom-elements.json",
    "./global-button.css": {
      "default": "./dist/global-button.css"
    },
    "./global-elements.css": {
      "default": "./dist/global-elements.css"
    },
    "./global-link.css": {
      "default": "./dist/global-link.css"
    },
    "./link.css": {
      "default": "./dist/link.css"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*/index.d.ts",
      "import": "./dist/patterns/*/index.js"
    },
    "./patterns/*.js": {
      "types": "./dist/patterns/*.d.ts",
      "default": "./dist/patterns/*.js"
    },
    "./patterns/*/index.js": {
      "types": "./dist/patterns/*/index.d.ts",
      "import": "./dist/patterns/*/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "analyze": "cem analyze --config cem.config.js",
    "analyze:watch": "cem analyze --config cem.config.js --watch",
    "build": "vite build && yarn analyze",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "dev:core": "yarn workspace @adobe/spectrum-wc-core dev",
    "generate:contributor-docs": "node .storybook/scripts/generate-contributor-docs.mjs",
    "generate:ui-icons": "node components/ui-icons/scripts/generate-ui-icons.mjs && prettier --write \"components/ui-icons/icon-set/*.ts\"",
    "storybook": "yarn generate:contributor-docs && yarn analyze && storybook dev -p 6006",
    "storybook:build": "yarn generate:contributor-docs && yarn analyze && storybook build",
    "storybook:build:vrt": "yarn analyze && SWC_STORYBOOK_MODE=vrt storybook build",
    "stylesheet:tokens": "swc-tokens --outputType tokens --out ./stylesheets/tokens.css --prefix swc",
    "stylesheet:typography": "swc-tokens --outputType typography --out ./stylesheets/typography.css --prefix swc",
    "test": "vitest --run --project storybook",
    "test:a11y": "test-storybook && playwright test",
    "test:a11y:headed": "playwright test --headed",
    "test:a11y:ui": "playwright test --ui",
    "test:browser": "vitest --project storybook --browser.headless=false",
    "test:coverage": "vitest --coverage --project storybook",
    "test:storybook": "test-storybook",
    "test:ui": "vitest --ui --project storybook",
    "test:watch": "run-p dev:core test:watch:vitest",
    "test:watch:vitest": "vitest --project storybook --watch"
  },
  "dependencies": {
    "@adobe/spectrum-wc-core": "2.0.0-beta.4",
    "@lit-labs/observers": "2.1.0",
    "lit": "^2.5.0 || ^3.1.3"
  },
  "devDependencies": {
    "@adobe/postcss-token": "workspace:*",
    "@adobe/spectrum-wc-icons": "workspace:*",
    "@adobe/swc-tokens": "workspace:*",
    "@adobe/vite-global-elements-css": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@chromatic-com/storybook": "5.4.0",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@github-ui/storybook-addon-performance-panel": "1.3.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@storybook/web-components-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "@wc-toolkit/storybook-helpers": "patch:@wc-toolkit/storybook-helpers@npm%3A10.7.7#~/.yarn/patches/@wc-toolkit-storybook-helpers-npm-10.7.7-34456c75ec.patch",
    "aria-query": "5.3.2",
    "autoprefixer": "10.6.1",
    "chromatic": "18.11.0",
    "dom-accessibility-api": "0.7.1",
    "glob": "13.0.6",
    "playwright": "1.53.1",
    "playwright-core": "1.53.1",
    "postcss": "8.5.29",
    "postcss-preset-env": "11.6.1",
    "prettier": "3.9.9",
    "query-selector-shadow-dom": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "rimraf": "6.1.3",
    "storybook": "patch:storybook@npm%3A10.6.1#~/.yarn/patches/storybook-npm-10.6.1-3ecf9cbc22.patch",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-lit-css": "3.1.0",
    "vitest": "5.0.3"
  },
  "keywords": [
    "design-system",
    "spectrum",
    "adobe",
    "adobe-spectrum",
    "web components",
    "web-components",
    "lit-element",
    "lit-html",
    "component",
    "css"
  ],
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
