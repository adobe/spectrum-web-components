import { html } from 'lit';
import type { Meta, StoryObj as Story } from '@storybook/web-components';

import '@adobe/spectrum-wc/components/{{dashCase name}}/swc-{{dashCase name}}.js';

import {
  createPermutations,
  forcedColorsVrtParameters,
  groupPermutationsBy,
  renderStorybookPermutation,
  row,
  theme,
  vrtParameters,
} from '../../../../.storybook/helpers/index.js';

// Metadata

const meta: Meta = {
  title: '{{titleName name}}/{{titleName name}} VRT',
  component: 'swc-{{dashCase name}}',
  tags: ['dev'],
};

export default meta;

// Helpers

// TODO: replace the placeholder `size` axis with this component's real API.
// Import its constants from '@adobe/spectrum-wc-core/components/{{dashCase name}}'
// (e.g. {{constantCase name}}_VALID_SIZES, {{constantCase name}}_VARIANTS) and
// cross the axes that matter. Add disabled/pending/selected state rows, forced
// pseudo-states (forcePseudoStates + a `play` function), and static-color
// backgrounds where applicable. See button.vrt.ts and the vrt-authoring skill.
const {{constantCase name}}_PERMUTATIONS = createPermutations([
  { size: ['s', 'm', 'l'] },
]);

const render{{pascalCase name}}Permutation = renderStorybookPermutation(
  'swc-{{dashCase name}}',
  { 'default-slot': '{{titleName name}}' }
);

const permutationContent = () => html`
  ${groupPermutationsBy({{constantCase name}}_PERMUTATIONS, 'size').map(
    ([size, perms]) =>
      row(perms.map(render{{pascalCase name}}Permutation), String(size))
  )}
`;

// VRT stories

// Rendered once in light/ltr and once in dark/rtl (that combination covers both
// axes) in a single story so it costs one snapshot.
export const Permutations: Story = {
  render: () => html`
    ${theme(permutationContent(), 'light', 'ltr')}
    ${theme(permutationContent(), 'dark', 'rtl')}
  `,
  parameters: vrtParameters,
};

// `forced-colors` replaces the whole page palette, so it needs its own
// story/snapshot rather than folding into Permutations.
export const ForcedColors: Story = {
  render: () => theme(permutationContent(), 'light', 'ltr'),
  parameters: forcedColorsVrtParameters,
};
