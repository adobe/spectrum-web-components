yarn lint-staged --allow-empty

# If any CONTRIBUTOR-DOCS files are staged, regenerate navigation and verify links,
# then regenerate the Storybook contributor-docs MDX and update preview.ts sort order.
if git diff --cached --name-only | grep -q "^CONTRIBUTOR-DOCS/"; then
  node CONTRIBUTOR-DOCS/01_contributor-guides/07_authoring-contributor-docs/update-nav.js "$(pwd)/CONTRIBUTOR-DOCS"
  git add CONTRIBUTOR-DOCS/
  (cd 2nd-gen/packages/swc && node .storybook/scripts/generate-contributor-docs.mjs)
  git add 2nd-gen/packages/swc/.storybook/preview.ts
fi

# If any component CSS files are staged, run the build so the vite plugin
# regenerates all global stylesheets, then stage the results.
if git diff --cached --name-only | grep -qE "^2nd-gen/packages/swc/components/.*\.css$"; then
  (cd 2nd-gen/packages/swc && yarn build)
  git add 2nd-gen/packages/swc/stylesheets/global/
fi

# If any per-unit MDX or stories file changed under the in-scope 2nd-gen
# directories, run the structural lint that enforces the per-unit MDX
# authoring standards (matches yarn lint:docs-pages / yarn lint:ai in CI).
if git diff --cached --name-only | grep -qE "^2nd-gen/packages/(swc/components|swc/patterns|core/controllers)/.*\.(mdx|stories\.ts)$"; then
  node scripts/validate-docs-pages.js || exit 1
fi

# If any 2nd-gen TypeScript source is staged, analyze its Lit templates (the
# CLI behind the runem.lit-plugin IDE extension — tsc and ESLint do not run
# it). Directory-agnostic and inclusive of stories, tests, and VRT files:
# template/setup errors there drive docs mistakes and test flakiness, so they
# are worth catching. New packages and folders are covered automatically.
# Scoped to the staged files, so it only fires on code you touch. Non-blocking
# while the backlog is cleared; drop the `|| true` to gate commits.
LIT_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E "^2nd-gen/.*\.ts$" || true)
if [ -n "$LIT_FILES" ]; then
  # lit-analyzer wants file paths before flags; word-split the newline list.
  # shellcheck disable=SC2086
  yarn lit-analyzer $LIT_FILES --strict || true
fi
