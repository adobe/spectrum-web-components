import { expect } from '@storybook/test';
import type { Meta, StoryObj as Story } from '@storybook/web-components';

import { {{pascalCase name}} } from '@adobe/spectrum-wc/{{dashCase name}}';

import '@adobe/spectrum-wc/components/{{dashCase name}}/swc-{{dashCase name}}.js';

import { getComponent } from '../../../utils/test-utils.js';
import meta, { Overview } from '../stories/{{dashCase name}}.stories.js';

// Dev-only test stories that reuse the main story metadata.
export default {
    ...meta,
    title: '{{titleName name}}/Tests',
    parameters: {
        ...meta.parameters,
        docs: { disable: true, page: null },
    },
    tags: ['!autodocs', 'dev'],
} as Meta;

// ──────────────────────────────────────────────────────────────
// TEST: Defaults and reflection
// ──────────────────────────────────────────────────────────────

export const OverviewTest: Story = {
    ...Overview,
    play: async ({ canvasElement, step }) => {
        const el = await getComponent<{{pascalCase name}}>(
            canvasElement,
            'swc-{{dashCase name}}'
        );

        await step('renders', async () => {
            expect(el).toBeDefined();
            expect(el).toBeInstanceOf({{pascalCase name}});
        });

        await step('applies the default size', async () => {
            expect(el.size).toBe('m');
        });

        await step('reflects size to the host attribute', async () => {
            el.size = 'l';
            await el.updateComplete;
            expect(el.getAttribute('size')).toBe('l');
        });

        // TODO: extend coverage for this component's real API. Loop the valid
        // sizes and variants (import {{constantCase name}}_VALID_SIZES /
        // {{constantCase name}}_VARIANTS from
        // '@adobe/spectrum-wc-core/components/{{dashCase name}}'), assert each
        // state (disabled, selected, invalid, ...) toggles the expected
        // attribute/behavior, and assert any dev-mode warnings via
        // withWarningSpy from '../../../utils/test-utils.js'.
    },
};
