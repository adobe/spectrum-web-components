{
  "name": "@adobe/spectrum-wc-icons",
  "version": "2.0.0-beta.2",
  "description": "Spectrum 2 workflow icons as tree-shakeable custom elements and SVG-string functions",
  "license": "Apache-2.0",
  "author": "Adobe",
  "homepage": "https://opensource.adobe.com/spectrum-web-components/",
  "repository": {
    "directory": "2nd-gen/packages/icons",
    "type": "git",
    "url": "https://github.com/adobe/spectrum-web-components.git"
  },
  "bugs": {
    "url": "https://github.com/adobe/spectrum-web-components/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./customElements": "./dist/custom-elements.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "sideEffects": [
    "**/swc-icon-*.js",
    "**/swc-icon-*.ts",
    "**/elements.js",
    "**/elements.ts"
  ],
  "scripts": {
    "analyze": "cem analyze --config cem.config.js",
    "build": "vite build && yarn analyze",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "prepublishOnly": "yarn build",
    "test": "node scripts/verify-tree-shaking.mjs",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs"
  },
  "dependencies": {
    "@adobe/spectrum-wc-core": "2.0.0-beta.2",
    "lit": "^2.5.0 || ^3.1.3"
  },
  "devDependencies": {
    "@adobe/postcss-token": "workspace:*",
    "@adobe/swc-tokens": "workspace:*",
    "@custom-elements-manifest/analyzer": "0.10.8",
    "autoprefixer": "10.4.21",
    "glob": "11.0.3",
    "postcss": "8.5.9",
    "postcss-preset-env": "10.4.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.2",
    "vite": "8.0.8",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lit-css": "2.2.2"
  },
  "keywords": [
    "design-system",
    "spectrum",
    "adobe",
    "adobe-spectrum",
    "web components",
    "web-components",
    "icons",
    "workflow-icons",
    "lit-element",
    "lit-html"
  ],
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
